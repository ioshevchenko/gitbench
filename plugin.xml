<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.views">
      <category id="gitbench.category" name="Gitbench"/>
      <view id="gitbench.views.commit"
            name="Commit"
            category="gitbench.category"
            class="gitbench.ui.commit.CommitView"
            icon="icons/png/light/commitToolWindow.png"/>
      <view id="gitbench.views.git"
            name="Git"
            category="gitbench.category"
            class="gitbench.ui.GitView"
            icon="icons/png/light/vcs.png"/>
      <view id="gitbench.views.log"
            name="Git Log"
            category="gitbench.category"
            class="gitbench.ui.log.GitLogView"
            icon="icons/png/light/vcs.png"/>
      <view id="gitbench.views.branches"
            name="Branches"
            category="gitbench.category"
            class="gitbench.ui.branch.BranchesView"
            icon="icons/png/light/vcs.png"/>
   </extension>
   <extension point="org.eclipse.ui.editors">
      <editor id="gitbench.editors.diff"
            name="Diff"
            icon="icons/png/light/diff.png"
            class="gitbench.ui.diff.DiffEditor"
            default="false"/>
   </extension>
   <extension point="org.eclipse.ui.workbench.texteditor.rulerColumns">
      <column id="gitbench.columns.changes"
            name="Gitbench Changes"
            class="gitbench.ui.status.ChangeMarkerColumn"
            enabled="true"
            global="true"
            includeInMenu="true">
         <placement gravity="0.9">
            <after id="org.eclipse.ui.editors.columns.linenumbers"/>
         </placement>
         <targetClass class="org.eclipse.ui.texteditor.AbstractDecoratedTextEditor"/>
      </column>
   </extension>
   <extension point="org.eclipse.ui.workbench.texteditor.rulerColumns">
      <column id="gitbench.columns.annotate"
            name="Git Blame"
            class="gitbench.ui.annotate.AnnotateColumn"
            enabled="false"
            global="false"
            includeInMenu="false">
         <placement gravity="0.8">
            <before id="org.eclipse.ui.editors.columns.linenumbers"/>
         </placement>
         <targetClass class="org.eclipse.ui.texteditor.AbstractDecoratedTextEditor"/>
      </column>
   </extension>
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="popup:#AbstractTextEditorRulerContext?after=additions">
         <command commandId="gitbench.annotate" label="Annotate with Git Blame" style="toggle"/>
      </menuContribution>
   </extension>
   <extension point="org.eclipse.ui.contexts">
      <context id="gitbench.contexts.diff"
            name="Gitbench Diff"
            parentId="org.eclipse.ui.contexts.window"/>
   </extension>
   <extension point="org.eclipse.ui.commands">
      <category id="gitbench.commands" name="Gitbench"/>
      <command id="gitbench.annotate" name="Annotate with Git Blame" categoryId="gitbench.commands"/>
      <command id="gitbench.changes.next" name="Next Change" categoryId="gitbench.commands"/>
      <command id="gitbench.changes.previous" name="Previous Change" categoryId="gitbench.commands"/>
      <command id="gitbench.changes.rollback" name="Rollback Lines" categoryId="gitbench.commands"/>
      <command id="gitbench.diff.nextDifference" name="Next Difference" categoryId="gitbench.commands"/>
      <command id="gitbench.diff.previousDifference" name="Previous Difference" categoryId="gitbench.commands"/>
      <command id="gitbench.diff.nextFile" name="Compare Next File" categoryId="gitbench.commands"/>
      <command id="gitbench.diff.previousFile" name="Compare Previous File" categoryId="gitbench.commands"/>
      <command id="gitbench.diff.applyLeftSide" name="Revert or Accept Block" categoryId="gitbench.commands"/>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler commandId="gitbench.annotate" class="gitbench.ui.annotate.AnnotateHandler"/>
      <handler commandId="gitbench.changes.next" class="gitbench.ui.status.ChangeMarkerHandlers$Next"/>
      <handler commandId="gitbench.changes.previous" class="gitbench.ui.status.ChangeMarkerHandlers$Previous"/>
      <handler commandId="gitbench.changes.rollback" class="gitbench.ui.status.ChangeMarkerHandlers$Rollback"/>
      <handler commandId="gitbench.diff.nextDifference" class="gitbench.ui.diff.DiffCommandHandler">
         <activeWhen>
            <with variable="activePartId">
               <equals value="gitbench.editors.diff"/>
            </with>
         </activeWhen>
      </handler>
      <handler commandId="gitbench.diff.previousDifference" class="gitbench.ui.diff.DiffCommandHandler">
         <activeWhen>
            <with variable="activePartId">
               <equals value="gitbench.editors.diff"/>
            </with>
         </activeWhen>
      </handler>
      <handler commandId="gitbench.diff.nextFile" class="gitbench.ui.diff.DiffCommandHandler">
         <activeWhen>
            <with variable="activePartId">
               <equals value="gitbench.editors.diff"/>
            </with>
         </activeWhen>
      </handler>
      <handler commandId="gitbench.diff.previousFile" class="gitbench.ui.diff.DiffCommandHandler">
         <activeWhen>
            <with variable="activePartId">
               <equals value="gitbench.editors.diff"/>
            </with>
         </activeWhen>
      </handler>
      <handler commandId="gitbench.diff.applyLeftSide" class="gitbench.ui.diff.DiffCommandHandler">
         <activeWhen>
            <with variable="activePartId">
               <equals value="gitbench.editors.diff"/>
            </with>
         </activeWhen>
      </handler>
   </extension>
   <extension point="org.eclipse.ui.bindings">
      <key commandId="gitbench.diff.nextDifference" contextId="gitbench.contexts.diff"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration" sequence="F7"/>
      <key commandId="gitbench.diff.previousDifference" contextId="gitbench.contexts.diff"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration" sequence="SHIFT+F7"/>
      <key commandId="gitbench.diff.nextFile" contextId="gitbench.contexts.diff"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration" sequence="ALT+SHIFT+ARROW_RIGHT"/>
      <key commandId="gitbench.diff.previousFile" contextId="gitbench.contexts.diff"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration" sequence="ALT+SHIFT+ARROW_LEFT"/>
      <key commandId="gitbench.diff.applyLeftSide" contextId="gitbench.contexts.diff"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration" sequence="M1+ALT+R"/>
   </extension>
   <extension point="org.eclipse.ui.preferencePages">
      <page id="gitbench.preferences"
            name="Gitbench"
            class="gitbench.ui.GitPreferencePage"/>
   </extension>
</plugin>
